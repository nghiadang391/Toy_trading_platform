# ToyTrade Environment Configuration Template
# Copy this file to .env.local and configure your secrets. Do NOT commit .env.local!

# 1. CKB Network Nodes
# Default local OffCKB devnet port is 28114
CKB_NODE_URL=http://127.0.0.1:28114
CKB_INDEXER_URL=http://127.0.0.1:28114

# 2. Database Configuration
# Prisma PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/toytrade?schema=public

# 3. Reference Pricing & Visual Search
# Sign up at serpapi.com for a free API key (250 searches/month)
SERPAPI_API_KEY=your_serpapi_api_key_here

# 4. Currency / Price Feed
# CoinGecko API Key (Optional for basic free tier usage, can leave blank)
COINGECKO_API_KEY=
