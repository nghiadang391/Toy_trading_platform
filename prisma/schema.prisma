datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String    @id @default(cuid())
  joyIdAddress    String    @unique    // JoyID wallet address
  displayName     String
  region          Region    @default(UK)
  avatarUrl       String?
  createdAt       DateTime  @default(now())

  listings        Listing[]
  tradesAsBuyer   Trade[]   @relation("buyer")
  tradesAsSeller  Trade[]   @relation("seller")
  ratingsGiven    Rating[]  @relation("rater")
  ratingsReceived Rating[]  @relation("rated")
  chatRoomsAsBuyer  ChatRoom[]    @relation("buyerRooms")
  chatRoomsAsSeller ChatRoom[]    @relation("sellerRooms")
  sentMessages      ChatMessage[]
}

model Listing {
  id              String         @id @default(cuid())
  title           String                      // "LEGO Star Wars #75192"
  description     String
  condition       ToyCondition
  category        ToyCategory
  priceFiat       Decimal                     // Price in local fiat (seller's price)
  currency        Currency       @default(GBP) // GBP or VND
  referencePriceFiat Decimal?                 // From image search (N/A if null)
  imageUrls       String                      // Uploaded photo URLs (JSON array)
  imageSearchHash String?                     // Hash for caching ref price lookup
  sporeDobId      String?        @unique      // Spore DOB Cell outpoint (Toy Passport)
  sporeTxHash     String?                     // Transaction hash of DOB mint
  status          ListingStatus  @default(ACTIVE)
  tradeMethod     TradeMethod                 // MEETUP, SHIPPING, BOTH
  shippingRegion  Region?
  location        String?                     // Detail address or meetup location (e.g. "Hammersmith, London" or "District 1, HCMC")
  isRecalled      Boolean        @default(false)
  recallReason    String?
  sellerId        String
  seller          User           @relation(fields: [sellerId], references: [id])
  createdAt       DateTime       @default(now())
  trades          Trade[]
  passportLogs    PassportLog[]
  chatRooms       ChatRoom[]
}

model Trade {
  id              String      @id @default(cuid())
  listingId       String
  listing         Listing     @relation(fields: [listingId], references: [id])
  buyerId         String
  buyer           User        @relation("buyer", fields: [buyerId], references: [id])
  sellerId        String
  seller          User        @relation("seller", fields: [sellerId], references: [id])
  priceFiat       Decimal                     // Locked fiat price
  priceCkb        BigInt                      // CKB amount (in shannons) at trade time
  exchangeRate    Decimal                     // CKB/USD rate at trade initiation
  method          TradeMethod                 // MEETUP or SHIPPING
  trackingNumber  String?                     // For shipping trades
  escrowTxHash    String?                     // CKB escrow transaction hash
  escrowCellOutpoint String?                  // Outpoint of the escrow Cell
  status          TradeStatus  @default(PENDING)
  buyerConfirmed  Boolean      @default(false)
  sellerConfirmed Boolean      @default(false)
  qrCodeToken     String?
  qrCodeExpiresAt DateTime?
  expiresAt       DateTime                    // Escrow timeout (7 days)
  createdAt       DateTime     @default(now())
  completedAt     DateTime?
  ratings         Rating[]
}

model PassportLog {
  id           String       @id @default(cuid())
  listingId    String
  listing      Listing      @relation(fields: [listingId], references: [id])
  tradeId      String?
  ownerAddress String
  condition    ToyCondition
  photoUrl     String?
  notes        String?
  createdAt    DateTime     @default(now())
}

model Rating {
  id          String   @id @default(cuid())
  tradeId     String
  trade       Trade    @relation(fields: [tradeId], references: [id])
  raterId     String
  rater       User     @relation("rater", fields: [raterId], references: [id])
  ratedUserId String
  ratedUser   User     @relation("rated", fields: [ratedUserId], references: [id])
  score       Int                             // 1-5 stars
  comment     String?
  createdAt   DateTime @default(now())

  @@unique([tradeId, raterId])                // One rating per user per trade
}

model ChatRoom {
  id         String        @id @default(cuid())
  listingId  String?
  listing    Listing?      @relation(fields: [listingId], references: [id])
  buyerId    String
  buyer      User          @relation("buyerRooms", fields: [buyerId], references: [id])
  sellerId   String
  seller     User          @relation("sellerRooms", fields: [sellerId], references: [id])
  messages   ChatMessage[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([listingId, buyerId, sellerId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum Region {
  UK
  VIETNAM
}

enum Currency {
  GBP
  VND
}

enum ToyCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum ToyCategory {
  ACTION_FIGURES
  BOARD_GAMES
  BUILDING_SETS
  DOLLS
  EDUCATIONAL
  OUTDOOR
  PUZZLES
  VEHICLES
  OTHER
}

enum ListingStatus {
  ACTIVE
  RESERVED
  TRADED
  CANCELLED
}

enum TradeMethod {
  MEETUP
  SHIPPING
  BOTH
}

enum TradeStatus {
  PENDING
  ESCROW_FUNDED
  SHIPPING
  BUYER_CONFIRMED
  SELLER_CONFIRMED
  COMPLETED
  EXPIRED
  DISPUTED
}
